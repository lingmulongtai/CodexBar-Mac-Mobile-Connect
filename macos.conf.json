{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBar + Mobile Connect",
  "identifier": "com.lingmulongtai.codexbar.mac",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexBar + Mobile Connect",
        "width": 496,
        "height": 800,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["../../../../icons/codexbar.icns", "../../../rust/icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
